# ── Ollama private server ─────────────────────────────────────────────────────
OLLAMA_HOST=http://<your-ollama-host>:11434

# ── Models ────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
GENERATION_MODEL=llama3.1:8b
GUARDRAIL_MODEL=llama-guard3:1b
VERIFIER_MODEL=qwen3.5:0.8b
RERANKER_MODEL=awenleven/Qwen3-Reranker-4B:q4_k_m

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wikipedia_docs

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=4
SIMILARITY_THRESHOLD=0.5

# ── Ingestion ─────────────────────────────────────────────────────────────────
WIKI_TOPICS=["Retrieval-augmented generation","Vector database","Large language model"]
WIKI_MAX_ARTICLES=15
